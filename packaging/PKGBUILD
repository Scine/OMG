# Maintainer: Snapshare contributors
pkgname=snapshare
pkgver=0.1.0
pkgrel=1
pkgdesc="ShareX-style screenshot capture, annotation and sharing tool for KDE Plasma on Wayland"
arch=('any')
url="https://github.com/scine/omg"
license=('GPL3')
depends=('python' 'python-pyqt6' 'python-requests' 'spectacle')
makedepends=('python-build' 'python-installer' 'python-wheel')
source=("$pkgname-$pkgver.tar.gz::https://github.com/scine/omg/archive/refs/heads/main.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir"/*/
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir"/*/
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/snapshare.desktop "$pkgdir/usr/share/applications/snapshare.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
